# PostgreSQL connection string used by the app, drizzle-kit and tests
DATABASE_URL=postgres://threepl:threepl@localhost:5432/threepl

# Secret used to seal session cookies (nuxt-auth-utils). MUST be at least 32 characters.
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-plus-character-secret

# Seed demo data (superadmin, demo shipper/carrier/drivers, sample loads) on boot.
# The seed is idempotent: it is skipped when the superadmin user already exists.
NUXT_SEED_DEMO_DATA=true

# Demo mode: the login page becomes a one-click account picker (no passwords).
# Compose defaults this to true for instant demos — set false (or remove the
# compose default) for any real deployment.
NUXT_PUBLIC_DEMO_MODE=true

# Optional override for the migrations folder (used by the Docker image).
# NUXT_MIGRATIONS_DIR=/app/migrations
